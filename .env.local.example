NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Direct Postgres connection string (used by the admin login API route).
# For Supabase hosted Postgres: Project Settings → Database → URI (direct, not pooler).
# For self-hosted Postgres: postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://user:password@host:5432/dbname
