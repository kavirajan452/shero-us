NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
NEXT_PUBLIC_APP_MODE=dev
NEXT_PUBLIC_DEV_LOGIN_PASSWORD=123456

# ── Supabase Edge Function env vars (set in Supabase Dashboard → Edge Functions → Secrets) ──

# Payment gateway (Stripe) — required in production
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_CURRENCY=usd

# SMS OTP gateway — required in production
# SMS_INTEGRA_API_URL=https://...
# SMS_INTEGRA_API_KEY=...
# SMS_INTEGRA_SENDER_ID=SHERO

# Tax ERP (Avalara AvaTax) — required in production; demo mode works without these
# AVALARA_ACCOUNT_ID=your_avalara_account_id
# AVALARA_LICENSE_KEY=your_avalara_license_key
# AVALARA_COMPANY_CODE=DEFAULT
# AVALARA_ENVIRONMENT=production   # production | sandbox

# App mode switch (controls all edge functions: dev = demo/simulated, production = live APIs)
# APP_MODE=dev
